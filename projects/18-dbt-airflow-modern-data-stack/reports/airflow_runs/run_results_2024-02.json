in <= 0 or duration_min > 360 then 'duration_out_of_range'\n        when trip_distance_miles <= 0 or trip_distance_miles > 200 then 'distance_out_of_range'\n        when fare_amount < 0 or total_amount < 0 then 'negative_amount'\n        when total_amount > 1000 then 'implausible_total'\n        when passenger_count = 0 then 'zero_passengers'\n        else null\n    end as dq_reason\nfrom base", "relation_name": "\"nyc_taxi\".\"intermediate\".\"int_trips_flagged\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:01.887226Z", "completed_at": "2026-11-17T23:30:01.891674Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:01.891962Z", "completed_at": "2026-11-17T23:30:02.724230Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.838754415512085, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.nyc_taxi.accepted_values_int_trips_flagged_dq_reason__duplicate_record__pickup_outside_file_month__duration_out_of_range__distance_out_of_range__negative_amount__implausible_total__zero_passengers.419ff5904f", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        dq_reason as value_field,\n        count(*) as n_records\n\n    from \"nyc_taxi\".\"intermediate\".\"int_trips_flagged\"\n    group by dq_reason\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'duplicate_record','pickup_outside_file_month','duration_out_of_range','distance_out_of_range','negative_amount','implausible_total','zero_passengers'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:02.731547Z", "completed_at": "2026-11-17T23:30:02.733542Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:02.733854Z", "completed_at": "2026-11-17T23:30:02.860365Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.1297459602355957, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.nyc_taxi.int_trips_enriched", "compiled": true, "compiled_code": "-- Valid trips only, enriched with zone names and payment descriptions.\nselect\n    t.trip_key, t.vendor_id, t.pickup_at, t.dropoff_at, t.duration_min,\n    t.passenger_count, t.trip_distance_miles, t.rate_code_id,\n    t.pickup_location_id, pz.borough as pickup_borough, pz.zone as pickup_zone,\n    t.dropoff_location_id, dz.borough as dropoff_borough, dz.zone as dropoff_zone,\n    t.payment_type, coalesce(p.payment_description, 'Not recorded') as payment_description,\n    t.fare_amount, t.tip_amount, t.tolls_amount, t.total_amount,\n    t.source_month\nfrom \"nyc_taxi\".\"intermediate\".\"int_trips_flagged\" t\nleft join \"nyc_taxi\".\"staging\".\"stg_taxi_zones\" pz on t.pickup_location_id = pz.location_id\nleft join \"nyc_taxi\".\"staging\".\"stg_taxi_zones\" dz on t.dropoff_location_id = dz.location_id\nleft join \"nyc_taxi\".\"staging\".\"stg_payment_types\" p on t.payment_type = p.payment_type\nwhere t.dq_reason is null", "relation_name": "\"nyc_taxi\".\"intermediate\".\"int_trips_enriched\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:02.728128Z", "completed_at": "2026-11-17T23:30:02.735715Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:02.736012Z", "completed_at": "2026-11-17T23:30:04.156662Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.4295010566711426, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.nyc_taxi.dq_rejections_by_month", "compiled": true, "compiled_code": "-- Data-quality report: how many raw rows each rule removed, per file month.\n-- Incremental by month, like fct_trips, so a monthly run keeps earlier months.\n\n\nselect\n    source_month,\n    coalesce(dq_reason, 'valid') as outcome,\n    count(*) as row_count,\n    round(100.0 * count(*) / sum(count(*)) over (partition by source_month), 3) as pct_of_month\nfrom \"nyc_taxi\".\"intermediate\".\"int_trips_flagged\"\ngroup by 1, 2", "relation_name": "\"nyc_taxi\".\"marts\".\"dq_rejections_by_month\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:02.876187Z", "completed_at": "2026-11-17T23:30:02.887332Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:02.887667Z", "completed_at": "2026-11-17T23:30:05.537063Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.67936635017395, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.nyc_taxi.fct_trips", "compiled": true, "compiled_code": "-- Trip fact table. Incremental by file month: a monthly run deletes and\n-- re-inserts only that month (delete+insert on source_month), so reruns and\n-- Airflow retries are idempotent. A --full-refresh rebuilds every month.\n\n\nselect * from \"nyc_taxi\".\"intermediate\".\"int_trips_enriched\"\n\nwhere source_month = '2024-02'\n", "relation_name": "\"nyc_taxi\".\"marts\".\"fct_trips\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:05.579975Z", "completed_at": "2026-11-17T23:30:05.583546Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:05.583899Z", "completed_at": "2026-11-17T23:30:05.628429Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.049834251403808594, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.nyc_taxi.non_negative_fct_trips_total_amount.9cf3afa3b9", "compiled": true, "compiled_code": "\nselect * from \"nyc_taxi\".\"marts\".\"fct_trips\" where total_amount < 0\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:05.574409Z", "comple
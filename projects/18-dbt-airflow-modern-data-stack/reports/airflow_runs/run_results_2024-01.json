ds\n\nfrom \"nyc_taxi\".\"marts\".\"dim_zones\"\nwhere location_id is not null\ngroup by location_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:54.029231Z", "completed_at": "2026-11-17T23:30:54.038178Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:54.038472Z", "completed_at": "2026-11-17T23:30:54.572460Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.5502865314483643, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.nyc_taxi.not_null_stg_yellow_trips_trip_key.911c797965", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect trip_key\nfrom \"nyc_taxi\".\"staging\".\"stg_yellow_trips\"\nwhere trip_key is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:54.576562Z", "completed_at": "2026-11-17T23:30:54.578547Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:54.578815Z", "completed_at": "2026-11-17T23:30:54.613969Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.03837871551513672, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.nyc_taxi.int_trips_flagged", "compiled": true, "compiled_code": "-- Apply the data-quality rules. Every staged row gets exactly one dq_reason\n-- (first rule that fails, in the order below) or NULL if it passes.\nwith base as (\n    select\n        *,\n        date_diff('second', pickup_at, dropoff_at) / 60.0 as duration_min,\n        row_number() over (partition by trip_key order by _loaded_at) as dup_rank\n    from \"nyc_taxi\".\"staging\".\"stg_yellow_trips\"\n)\nselect\n    *,\n    case\n        when dup_rank > 1 then 'duplicate_record'\n        when strftime(pickup_at, '%Y-%m') <> source_month then 'pickup_outside_file_month'\n        when duration_min <= 0 or duration_min > 360 then 'duration_out_of_range'\n        when trip_distance_miles <= 0 or trip_distance_miles > 200 then 'distance_out_of_range'\n        when fare_amount < 0 or total_amount < 0 then 'negative_amount'\n        when total_amount > 1000 then 'implausible_total'\n        when passenger_count = 0 then 'zero_passengers'\n        else null\n    end as dq_reason\nfrom base", "relation_name": "\"nyc_taxi\".\"intermediate\".\"int_trips_flagged\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:54.620656Z", "completed_at": "2026-11-17T23:30:54.625319Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:54.625599Z", "completed_at": "2026-11-17T23:30:55.436560Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.8177378177642822, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.nyc_taxi.accepted_values_int_trips_flagged_dq_reason__duplicate_record__pickup_outside_file_month__duration_out_of_range__distance_out_of_range__negative_amount__implausible_total__zero_passengers.419ff5904f", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        dq_reason as value_field,\n        count(*) as n_records\n\n    from \"nyc_taxi\".\"intermediate\".\"int_trips_flagged\"\n    group by dq_reason\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'duplicate_record','pickup_outside_file_month','duration_out_of_range','distance_out_of_range','negative_amount','implausible_total','zero_passengers'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:55.466999Z", "completed_at": "2026-11-17T23:30:55.468948Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:55.469222Z", "completed_at": "2026-11-17T23:30:55.527909Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.06859922409057617, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.nyc_taxi.int_trips_enriched", "compiled": true, "compiled_code": "-- Valid trips only, enriched with zone names and payment descriptions.\nselect\n    t.trip_key, t.vendor_id, t.pickup_at, t.dropoff_at, t.duration_min,\n    t.passenger_count, t.trip_distance_miles, t.rate_code_id,\n    t.pickup_location_id, pz.borough as pickup_borough, pz.zone as pickup_zone,\n    t.dropoff_location_id, dz.borough as dropoff_borough, dz.zone as dropoff_zone,\n    t.payment_type, coalesce(p.payment_description, 'Not recorded') as payment_description,\n    t.fare_amount, t.tip_amount, t.tolls_amount, t.total_amount,\n    t.source_month\nfrom \"nyc_taxi\".\"intermediate\".\"int_trips_flagged\" t\nleft join \"nyc_taxi\".\"staging\".\"stg_taxi_zones\" pz on t.pickup_location_id = pz.location_id\nleft join \"nyc_taxi\".\"staging\".\"stg_taxi_zones\" dz on t.dropoff_location_id = dz.location_id\nleft join \"nyc_taxi\".\"staging\".\"stg_payment_types\" p on t.payment_type = p.payment_type\nwhere t.dq_reason is null", "relation_name": "\"nyc_taxi\".\"intermediate\".\"int_trips_enriched\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-17T23:30:55.441209Z", "completed_at": "2026-11-17T23:30:55.444191Z"}, {"name": "execute", "started_at": "2026-11-17T23:30:55.444489Z", "completed_at": "2026-11-17T23:30:56.800708Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.3605105876922607, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.nyc_taxi.dq_rejections_by_month", "compiled": true, "compiled_code": "-- Data-quality report: how many raw rows each rule removed, per file month.\n-- Incremental by month, like fct_trips, so a monthly run keeps earlier months.\n\n\nselect\n    source_month,\n    coalesce(dq_reason, 'valid') as outcome,\n    count(*) 